<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bench</name>
  <version>0.0.0</version>
  <description>Bench test tools for the arm's motors: a window for finding each joint's top speed and acceleration (no encoders: checked against a visual marker).</description>
  <maintainer email="zachw@todo.todo">zachw</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>arm_bridge</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
