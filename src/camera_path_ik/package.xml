<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_path_ik</name>
  <version>0.0.0</version>
  <description>Closed-form inverse kinematics that moves the camera arm along a camera path while it looks at the focus path, with an RViz preview.</description>
  <maintainer email="zachw@todo.todo">zachw</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>camera_path_interfaces</exec_depend>
  <exec_depend>camera_path_editor</exec_depend>
  <exec_depend>arm_description_v2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <!-- Only the numerical cross-check (ik_numeric.py, used by the tests) needs scipy. -->
  <test_depend>python3-scipy</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
